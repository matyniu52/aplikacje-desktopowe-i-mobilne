<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MvvmTemperatureConverterMauiApp.MainPage"
             xmlns:local="clr-namespace:MvvmTemperatureConverterMauiApp"
    >
    <ContentPage.BindingContext>
        <local:ConverterViewModel/>
    </ContentPage.BindingContext>
    
    <ScrollView>
        <StackLayout Orientation="Vertical" HorizontalOptions="Center" Spacing="25">
            <Label Text="Wybierz" WidthRequest="150"/>
            <Picker SelectedItem="{Binding UnitToConvertFrom}" ItemsSource="{Binding PickerItems}" WidthRequest="150">
             
            </Picker>
            <Label Text="Wprowadź" WidthRequest="150"/>
            <Entry Text="{Binding EntryValueToConvert}" WidthRequest="150"/>
            <Button Command="{Binding ConvertCommand}" Text="Przelicz" HorizontalOptions="Center" WidthRequest="150"/>
            <Label Text="{Binding Result}" HorizontalOptions="Center" WidthRequest="150"></Label>
        </StackLayout>
    </ScrollView>

</ContentPage>
